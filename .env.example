MAINTAINEROS_ENVIRONMENT=development
MAINTAINEROS_DATABASE_URL=postgresql+asyncpg://maintainer:maintainer@localhost:5432/maintainer
MAINTAINEROS_REDIS_URL=redis://localhost:6379/0
MAINTAINEROS_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
MAINTAINEROS_STORAGE=memory
MAINTAINEROS_SQLITE_PATH=maintainer_os.db
MAINTAINEROS_WORKER_WORKSPACE_ROOT=/tmp/maintainer-os-workspaces
MAINTAINEROS_WORKER_LEASE_SECONDS=300
